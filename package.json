{
  "name": "dsh-comfyui-console",
  "version": "0.2.36",
  "private": false,
  "type": "module",
  "description": "ComfyUI 交互控制台：侧边栏面板登记并运行工作流，填参数、传素材、看进度与产物；同时向 DSH 会话暴露一组出片工具，可被 AI 调度调用。",
  "icon": "icon.svg",
  "engines": { "dsh": ">=0.2.0-rc.2" },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale"
      ]
    }
  },
  "license": "MIT"
}
